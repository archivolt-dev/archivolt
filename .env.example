# Skopiuj do .env (lokalne narzędzia) i/lub ustaw jako zmienne środowiskowe systemu.
# Claude Code / Codex czytają tokeny MCP ze zmiennych środowiskowych PROCESU, nie z .env.

GITHUB_PAT=            # fine-grained PAT dla GitHub MCP (zakres w SETUP.md)
CONTEXT7_API_KEY=      # darmowy klucz z context7.com (dokumentacja bibliotek)

# Od E1 / E4
NEO4J_PASSWORD=change-me-local
ANTHROPIC_API_KEY=     # tylko do eksperymentów (RQ2, RQ3) i profilu chmurowego
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1   # Ollama
